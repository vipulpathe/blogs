<%- include('partials/header') %>
    <div class="container my-4">
        <h1>Welcome to Blogs!</h1>
        <p>Here you can find the latest blogs on various topics and you can also create and edit your own blogs.</p>
    </div>

    <% if(locals.blogs) { %>
        <div class="container">
            <h2>Latest Blogs</h2>
            <div class="row">
                <% locals.blogs.forEach(blog => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title"><%= blog.title %></h5>
                                <p class="card-text"><%= blog.content.substring(0, 100) %><% if(blog.content.length>100){%>...<% } %></p>
                                <a href="/blogs/<%= blog._id %>" class="btn btn-primary">Read More</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

    <% } %>

    <%- include('partials/footer') %>