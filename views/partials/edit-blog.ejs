<%- include("header.ejs") %>

<div class="container my-4">
    <h1>Edit Blog</h1>
    <form action="/blog/<%= locals.blog._id %>/update" method="POST">
        <div class="mb-3">
            <label for="title" class="form-label">Blog Title</label>
            <input type="text" class="form-control" id="title" name="title" value="<%= locals.blog.title %>" required>
        </div>
        <div class="mb-3">
            <label for="content" class="form-label">Blog Content</label>
            <textarea class="form-control" id="content" name="content" rows="5" required><%= locals.blog.content %></textarea>
        </div>
        
        <button type="submit" class="btn btn-primary">Update Blog</button>
    </form>
</div>

<%- include("footer.ejs") %>
